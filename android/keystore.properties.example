# Copy this file to android/keystore.properties (gitignored) and fill in real
# values to produce a Play-Store-signable release build.
#
# Generate an upload keystore once:
#   keytool -genkeypair -v -keystore upload-keystore.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Keep upload-keystore.jks and these passwords backed up somewhere safe and
# OUT of the repo. If you enrol in Play App Signing (recommended), this key
# only signs the upload artifact; Google holds the real app signing key.

storeFile=../upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
